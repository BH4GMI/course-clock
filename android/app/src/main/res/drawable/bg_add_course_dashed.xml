<?xml version="1.0" encoding="utf-8"?>
<!--
  「添加课程」那一格的虚线框（设计稿 8 里最后一格）。

  虚线是画在图上的，所以这一格**没有背景色**——它就是一块空地，"空"本身就是提示。
  颜色取 text_secondary（浅深两套都在 colors.xml / values-night），不写死 hex。
  虚线间距比系统默认大一点：网格里一格只有 156dp 宽，密虚线看着像实线。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="@color/text_secondary"
        android:dashGap="5dp"
        android:dashWidth="5dp" />
    <corners android:radius="@dimen/group_radius" />
</shape>
