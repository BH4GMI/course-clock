<?xml version="1.0" encoding="utf-8"?>
<!--
  日视图小部件（4×2「今日课程」）的底板。

  与周视图那块的 `widget_panel_bg` **是两个文件**：周视图是 4×4 的一块深色底板，日视图这张卡
  按设计稿要用「卡片」那一层色（`card_background`，浅色纯白 / 深色 #1C1C1E）。圆角按
  HyperOS 官方小部件规范交付：1080p 屏 55px、2K 屏 73px —— 数值统一在
  widget_corner_radius（sw411dp 下给 2K 的覆盖值），与周视图共用同一个 token，但底色仍各是各的。

  为什么是 shape 而不是 View#setBackgroundColor：后者是直角，圆角只有背景图能给。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_panel_background" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
