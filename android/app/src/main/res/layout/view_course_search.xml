<?xml version="1.0" encoding="utf-8"?>
<!--
  课程管理页顶部那条搜索框（设计稿 8 的第一条）。

  页面自己的搜索，不走 BaseListActivity.searchView：那边搜索框长在标题栏里、
  点放大镜才出现，这一屏的搜索是**常驻**的（课程多的时候第一眼就要能用），
  所以和「清空」各占一头 —— 清空仍在标题栏最右，离手指最远。

  放大镜和输入框是两个并排的兄弟节点，不是 drawableStart：
  输入框的文字起点就固定在放大镜右侧，不会因为字形行高把图标顶偏。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/bg_search_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_inset"
    android:paddingEnd="@dimen/page_inset">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_search" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/course_manage_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"
        android:singleLine="true"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

</androidx.appcompat.widget.LinearLayoutCompat>
