<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_course_detail_sheet"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/course_detail_inset"
        android:paddingEnd="@dimen/course_detail_inset"
        android:paddingBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="课程详情"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/close_detail" style="@style/IconTextViewStyle"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:contentDescription="关闭课程详情" android:text="@string/icon_close"
                android:textColor="@color/text_secondary" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/course_switcher"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginBottom="12dp" android:gravity="center_vertical" android:visibility="gone">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/previous_course"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一门重叠课程" android:padding="14dp" android:rotation="180"
                app:srcCompat="@drawable/ic_chevron_right" app:tint="@color/widget_panel_text" />
            <TextView android:id="@+id/course_counter"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="?attr/selectableItemBackground" android:clickable="true"
                android:focusable="true" android:gravity="center"
                android:textColor="@color/colorPrimary" android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/next_course"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一门重叠课程" android:padding="14dp"
                app:srcCompat="@drawable/ic_chevron_right" app:tint="@color/widget_panel_text" />
        </LinearLayout>
        <View android:id="@+id/v_color_bar" android:layout_width="32dp" android:layout_height="3dp"
            android:layout_marginBottom="12dp" android:background="@color/colorPrimary" />
        <TextView android:id="@+id/tv_course_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/widget_panel_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/colorPrimary"
            android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/tv_time_value"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_panel_text" android:textSize="25sp" />
        <TextView android:id="@+id/tv_when"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tv_weeks"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:background="@color/list_divider" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top">
            <TextView style="@style/IconTextViewStyle" android:layout_width="28dp" android:layout_height="28dp"
                android:gravity="center_vertical" android:text="@string/icon_location"
                android:textColor="@color/text_secondary" android:textSize="19sp" />
            <TextView android:id="@+id/tv_room_value" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="28dp" android:gravity="center_vertical"
                android:textColor="@color/widget_panel_text" android:textSize="17sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_teacher_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="28dp" android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center_vertical">
            <TextView android:id="@+id/row_reminder" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                android:text="提醒设置" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/ib_edit"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="编辑课程"
                android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_edit" app:tint="@color/colorPrimary" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/ib_delete_course"
                android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="删除课程"
                android:padding="12dp" app:srcCompat="@android:drawable/ic_menu_delete" app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
