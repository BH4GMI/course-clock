<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_edge_padding"
    android:background="@drawable/widget_panel_bg">

    <!--
        表头两行都铺到最右边：右上角那两个箭头（下一周 / 回到本周）已删除，它们占掉的宽度
        正好让日期与「我的课表 | 第 N 周　周 X」完整显示。
    -->
    <TextView
        android:id="@+id/tv_date"
        android:textColor="@color/widget_panel_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="8月9日"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_week"
        android:textColor="@color/widget_panel_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_date"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="middle"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="我的课表 | 第1周    周四"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/weekName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_week"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title0"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_title0_1"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title1"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title2"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title3"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title4"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title5"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title6"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_title7"
            style="@style/ScheduleHeaderStyle"
            android:layout_width="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <ListView
        android:id="@+id/lv_schedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/weekName"
        android:divider="@null" />

</RelativeLayout>
