<?xml version="1.0" encoding="utf-8"?>
<!--
  侧栏抽屉的头部：上面是「课钟」+ 一句说明，最上层是 iv_header。

  抽屉已经不用 NavigationView（它的行样式被 Material 定死），没有 inflateHeaderView 了，
  这份布局由 ScheduleActivityUI 自己 inflate 后塞进抽屉的第一行，所以根布局不设固定高度：
  高度由文字块撑开。

  三条约束，改的时候别踩：
  · iv_header 必须留在**最上层**：用户设了侧栏背景图时它铺满整个头部、盖住这里的两行字；
    没设时被清空，露出抽屉自己的卡片色。它是"换侧栏背景图"的那一层，别删。
  · 头部不给固定背景色：抽屉底是 card_background（浅色 #FFFFFF / 深色 #1C1C1E），
    文字走主题属性（?attr/colorOnBackground / text_secondary），两套主题才都成立。
    早先写成 @color/main_background 会在深色模式下变成"白底白字"。
  · 顶部那段状态栏留白不在这里给：XML 里拿不到状态栏高度，ScheduleActivityUI 在 inflate
    之后按实际高度补上（写死 56dp 在刘海屏上会顶到系统时间）。

  两行文案：标题用 @string/app_name（就是「课钟」，本来就是应用名，不该复制一份字面量）；
  副标题「课程表 · 上课提醒」没有对应的字符串资源，与抽屉那几行的文案一起写在 Kotlin 里。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/nav_header_titles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/nav_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnBackground"
            android:textSize="24sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/nav_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:includeFontPadding="false" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

</FrameLayout>
