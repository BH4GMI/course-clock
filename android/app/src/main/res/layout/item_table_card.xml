<?xml version="1.0" encoding="utf-8"?>
<!--
  多课表卡片（设计稿 7）：88dp 高、圆角 20。

  左边 64dp 色块写「表名首字 + 周数区间」——不再写「周一/周二」这种和课表无关的装饰。
  色块底色由代码染：当前表 = 主题强调色（实心），其他表 = 课程调色板 20% 透明度。
  右侧表名 16sp + 「N 门课程 · 正在使用」12sp，操作按钮始终可见。
  整卡可点（切换）、可长按（同操作按钮菜单）。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_table"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="@dimen/group_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 色块：12dp 内边距（64×64 居中在 88 高的卡里），底色和文字颜色都在适配器里染。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_table_avatar"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_avatar_char"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="我" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_avatar_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:includeFontPadding="false"
                android:textSize="10sp"
                tools:text="1-16 周" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_table_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tv_table_subtitle"
            app:layout_constraintEnd_toStartOf="@id/btn_table_actions"
            app:layout_constraintStart_toEndOf="@id/ll_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="我的课表" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_table_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_table_actions"
            app:layout_constraintStart_toStartOf="@id/tv_table_name"
            app:layout_constraintTop_toBottomOf="@id/tv_table_name"
            tools:text="9 门课程 · 正在使用" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_table_actions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/table_actions"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
