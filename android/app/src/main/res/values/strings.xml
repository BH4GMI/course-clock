    <string name="import_from_file_desc">换手机或重装时用</string>

    <!--
      课程详情面板（设计稿 4）。文案面向本科生：短、说人话。
      摘要在上面（周几第几节、第几周），明细在下面（上课时间 / 授课教师 / 上课地点 / 上课提醒），
      两处不重复。行名带上"上课"两个字：面板里同时有"上课提醒"这类行，只写"时间"会被读成当前时刻。
    -->
    <string name="course_detail_time">上课时间</string>
    <string name="course_detail_teacher">授课教师</string>
    <string name="course_detail_room">上课地点</string>
    <string name="course_detail_reminder">上课提醒</string>
    <string name="course_detail_edit">编辑课程</string>
    <string name="course_detail_delete">删除</string>
    <!-- 详情里的空值：不写"—"（用户读不出那是"没有"还是"没查到"）。 -->
    <string name="course_detail_unknown">未填</string>
    <!-- 提醒那一行的当前值：总开关关着 / 开着时提前几分钟。 -->
    <string name="course_detail_remind_off">未开启</string>
    <string name="course_detail_remind_before">上课前 %1$d 分钟</string>
    <!--
      删除的二次确认。原文案"再点一次确定删除\n长按可以同时删除这门课程的其他时间哦"把两件事
      混在一句里，而且"其他时间"是数据模型的说法（同一门课在一周里的多次安排）。这里分开说清楚。
    -->
    <string name="course_detail_delete_tips">再点一次「删除」确认。\n长按「删除」可以一次删掉这门课一周里的其他几节。</string>

    <!--
      关于页的文案（设计稿 11，2026-09-18 按"更正式"重写，同日按"分栏太多"合并）。

      三张卡：应用信息（含项目地址）/ 使用说明 / 权限说明，开源署名与免费声明回到页脚。
      原来那节叫「权限」，下面写的是系统权限名（网络 / 振动 / 开机自启）—— 用户关心的不是叫什么，
      是"为什么需要"，所以每行都补了用途。改动如下：
      · 节标题去口语：「怎么用」→「使用说明」，「应用会用到」→「权限说明」；
      · 步骤写成完整的陈述句（句末带句号），不再用"点右下角""读回课程"这类口语动词；
      · 「开机自动恢复」改成系统里真正的名字「开机自启动」，说明补上"设备重启"这个前提；
      · 原来还给开源声明单独立过一节标题 + 一张卡，与上面三张并排就成了第四栏、第五栏 ——
        现在它与免费声明、版权一起收进页脚（署名仍然完整可见，只是不再占一个栏目）。
      「导入的课表保存在本机」这类自我说明仍然不写 —— 那是对实现的要求，写在 README 里就够。
    -->
    <string name="about_project">项目地址：https://github.com/BH4GMI/course-clock</string>
    <string name="about_howto">使用说明</string>
    <string name="about_step1">在「导入课程」中选择「从学校教务导入」。</string>
    <string name="about_step2">在弹出的页面中登录学校 WebVPN。</string>
    <string name="about_step3">返回课表页面，点击右下角按钮获取课程。</string>
    <string name="about_howto_note">更换设备时，亦可使用此前备份的课表文件导入。</string>
    <string name="about_uses">权限说明</string>
    <string name="about_use_network">网络访问</string>
    <string name="about_use_network_why">仅用于从学校教务系统导入课表数据</string>
    <string name="about_use_notify">通知与振动</string>
    <string name="about_use_notify_why">用于在课程开始前发送上课提醒</string>
    <string name="about_use_boot">开机自启动</string>
    <string name="about_use_boot_why">用于在设备重启后重新安排课程提醒</string>

