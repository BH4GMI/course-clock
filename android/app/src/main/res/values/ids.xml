    <!--
      课表下方留白区**按需存在**（设置里开了才加进来）。虚线网格则完全不占位：它画在
      content 的背景上，不是视图 —— 曾经作为 MATCH_PARENT 子视图让课表高度塌成 0。
    -->
    <item name="anko_schedule_blank_area" type="id" />

    <!-- 星期轴下面标出"今天"那一列的滑块。名字不进任何算术区间，加在末尾不影响上面的 id。 -->
    <item name="anko_tv_today_slider" type="id" />

    <!-- 星期轴整行的下沿（所有格子底边里最低的那条），网格钉在它下面。 -->
    <item name="anko_week_axis_bottom" type="id" />

    <!-- 星期轴一格里的两行：上行「周几 / 月」，下行日期。 -->
    <item name="anko_tv_title_label" type="id" />
    <item name="anko_tv_title_value" type="id" />

    <!--
      侧栏抽屉的行 id。

      抽屉不再用 NavigationView + 菜单 XML（NavigationView 的行样式被 Material 定死：纯图标 + 文字，
      做不到设计稿的"当前项蓝底胶囊 + 圆形图标底 + 56dp 行高"），行改由 ScheduleActivityUI 自己搭，
      id 就从菜单 XML 挪到这里。加在文件最末尾：上面 anko_tv_title0..7 / anko_tv_node* /
      anko_ll_week_panel_* 那几段是按算术取用的连续区间，插进去会让后面的 id 整体前移。
    -->
    <item name="nav_row_schedule" type="id" />
    <item name="nav_row_course" type="id" />
    <item name="nav_row_setting" type="id" />
    <item name="nav_row_about" type="id" />
    <item name="nav_row_new_table" type="id" />
    <item name="nav_row_divider" type="id" />
    <!--
      nav_row_new_table / nav_row_divider 自 2026-09-18 起不再有引用：抽屉里那行「新建课表」
      与它上面那条分隔线都撤掉了（新建课表仍由底部面板提供）。保留声明不删 —— 本文件按
      "条目顺序即 id" 管理（见文件顶部），删条目会让后面的条目整体前移，而留着它们不花任何代价。
    -->
    <item name="ll_add_course_actions" type="id" />

    <!--
      背景图加载的"本次请求标记"，打在 ImageView 的 tag 上。
      解码在后台线程做，回调回来时用它判断这个 View 有没有被 RecyclerView 绑到别的数据上
      （Glide 自动做的事，BackgroundImageLoader 靠它实现，见那里的注释）。
      同样加在末尾：上面的 id 区间是连着取用的。
    -->
    <item name="bg_image_load_key" type="id" />

    <!--
      这个 View 上"当前真正显示的那张图"的叶子 Drawable，同样打在 ImageView 的 tag 上。
      交叉淡入需要知道"从哪张淡到哪张"，而 view.drawable 在渐变进行中拿到的是
      TransitionDrawable 本身；拿它当下一轮的旧层就会一层套一层，把历史上每一张 Bitmap
      永久钉在引用链上（BackgroundImageLoader.attach 的注释里有完整说明）。
      仍加在末尾：上面的 id 区间是连着取用的。
    -->
    <item name="bg_image_current" type="id" />
</resources>